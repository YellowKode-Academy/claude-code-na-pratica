{
  "permissions": {
    "allow": [
      "Bash(pytest tests/:*)"
    ],
    "ask": [
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-main-commit.sh"
          }
        ]
      }
    ]
  }
}
