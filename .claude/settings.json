{
  "mcpServers": {
    "ci-status": {
      "command": "node",
      "args": ["./mcp-ci-status/server.js"],
      "env": {
        "CI_API_TOKEN": "$CI_API_TOKEN"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(pytest tests/:*)"
    ],
    "ask": [
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/block-main-commit.sh" }
        ]
      }
    ]
  }
}
